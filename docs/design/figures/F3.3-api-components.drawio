<mxfile host="drawio" type="device"><diagram id="d1" name="Express API components"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Express API  |  Components" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#1A2A44;" vertex="1" parent="1"><mxGeometry x="30.0" y="12.0" width="500.0" height="30.0" as="geometry"/></mxCell><mxCell id="c2" value='&lt;b style="font-size:16px"&gt;HTTP routes and middleware&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;Dispatch REST requests and check access&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F4F9;strokeColor=#B8C4D6;fontFamily=Helvetica;fontColor=#1A2A44;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="308.0" y="70.0" width="285.0" height="61.0" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:16px"&gt;Identity and Accounts&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;Verify JWT and active membership&lt;br&gt;Check role, team and ownership&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFF3EC;strokeColor=#86CDAE;fontFamily=Helvetica;fontColor=#1A2A44;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45.0" y="197.0" width="240.0" height="77.0" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:16px"&gt;Scheduling&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;Availability, staffing and overtime&lt;br&gt;Eligibility, draft and publication&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFF3EC;strokeColor=#86CDAE;fontFamily=Helvetica;fontColor=#1A2A44;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330.0" y="197.0" width="240.0" height="77.0" as="geometry"/></mxCell><mxCell id="c5" va
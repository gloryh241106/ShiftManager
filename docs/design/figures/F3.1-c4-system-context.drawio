<mxfile host="drawio" type="device"><diagram id="d1" name="C4 level 1 - System context"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="C4 level 1  |  System context" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontStyle=1;fontColor=#1A2A44;" vertex="1" parent="1"><mxGeometry x="30.0" y="12.0" width="500.0" height="30.0" as="geometry"/></mxCell><mxCell id="c2" value='&lt;b style="font-size:16px"&gt;Employee&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;Views own shifts and acknowledges changes&lt;br&gt;Submits availability, absences and offer replies&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFEBFD;strokeColor=#9DBDF0;fontFamily=Helvetica;fontColor=#1A2A44;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30.0" y="66.0" width="255.0" height="86.0" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:16px"&gt;Manager&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;Manages accounts, staffing and weekly schedules&lt;br&gt;Coordinates absence coverage&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFEBFD;strokeColor=#9DBDF0;fontFamily=Helvetica;fontColor=#1A2A44;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="323.0" y="66.0" width="255.0" height="86.0" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:16px"&gt;Boss&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;Reviews team coverage, workload&lt;br&gt;and acknowledgement progress&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFEBFD;strokeColor=#9DBDF0;fontFamily=Helvetica;fontColor=#1A2A44;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="615.0" y="66.0" width="255.0" height="86.0" as="geometr
%%{init: {
  "theme": "default",
  "themeVariables": {"fontFamily": "Arial, sans-serif"},
  "c4": {
    "diagramMarginX": 60,
    "diagramMarginY": 60,
    "c4ShapeMargin": 150,
    "c4ShapePadding": 30,
    "width": 380,
    "height": 230,
    "boxMargin": 60,
    "personFontSize": "20px",
    "systemFontSize": "20px",
    "external_systemFontSize": "20px",
    "messageFontSize": "17px",
    "wrap": true,
    "maxWidth": 380
  }
}}%%
C4Context
    title System Context View: ShiftManager

    Person(employee, "Employee", "Views own shifts, requests swaps and responds to swap invitations")
    Person(manager, "Manager", "Assigns shifts, views the team roster and decides on swaps")

    System(shiftmanager, "ShiftManager", "Web application for scheduling shifts and swapping shifts with co-worker consent and manager approval")
    System_Ext(email, "Email Service", "Optional (F08): sends alerts on swap responses and decisions")

    Rel(employee, shiftmanager, "Views shifts and requests swaps using")
    Rel(manager, shiftmanager, "Assigns shifts and approves swaps using")
    Rel(shiftmanager, email, "Sends e-mails using")

    UpdateElementStyle(employee, $fontColor="#2E7D00", $bgColor="#FFFFFF", $borderColor="#2E7D00")
    UpdateElementStyle(manager, $fontColor="#2E7D00", $bgColor="#FFFFFF", $borderColor="#2E7D00")
    UpdateElementStyle(shiftmanager, $fontColor="#1168BD", $bgColor="#FFFFFF", $borderColor="#1168BD")
    UpdateElementStyle(email, $fontColor="#C0121C", $bgColor="#FFFFFF", $borderColor="#C0121C")

    UpdateRelStyle(employee, shiftmanager, $textColor="#333333", $lineColor="#444444", $offsetX="-110", $offsetY="-20")
    UpdateRelStyle(manager, shiftmanager, $textColor="#333333", $lineColor="#444444", $offsetX="-60", $offsetY="-60")
    UpdateRelStyle(shiftmanager, email, $textColor="#333333", $lineColor="#444444", $offsetX="-70", $offsetY="-25")

    UpdateLayoutConfig($c4ShapeInRow="2", $c4BoundaryInRow="1")